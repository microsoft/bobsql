@inherits LayoutComponentBase
@using Microsoft.Extensions.Options
@using WardGeneral.Web.Options
@inject IOptions<FeatureFlags> Features

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="health-system">Part of the <strong>Collier Health System</strong></span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@if (Features.Value.Assistant)
{
    <AssistantDock />
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
