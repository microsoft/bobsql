#requires -Version 7.0
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
Import-Module (Join-Path $PSScriptRoot 'Studio.Engine.psm1') -DisableNameChecking

function Get-StudioHash {
    param([string] $Text)
    return [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($Text)))
}

function Get-StudioModuleFingerprint {
    param([string] $Definition)
    if (-not ('Microsoft.SqlServer.TransactSql.ScriptDom.TSql160Parser' -as [type])) {
        $provider = Get-Module SqlServer -All | Select-Object -First 1
        if (-not $provider) { Stop-StudioOperation 'SqlParserRequired' 'The existing SqlServer module lexical parser is required to compare stored modules.' }
        $path = Join-Path $provider.ModuleBase 'coreclr\Microsoft.SqlServer.TransactSql.ScriptDom.dll'
        [void][Reflection.Assembly]::LoadFrom($path)
    }
    $parser = [Microsoft.SqlServer.TransactSql.ScriptDom.TSql160Parser]::new($true)
    $reader = [IO.StringReader]::new($Definition)
    try {
        $errors = $null
        $tokens = @($parser.GetTokenStream($reader,[ref]$errors) | Where-Object {
            $_.TokenType.ToString() -notin @('WhiteSpace','SingleLineComment','MultilineComment','EndOfFile')
        })
        if ($errors.Count -ne 0) { Stop-StudioOperation 'ModuleVerificationFailed' 'Stored module tokenization failed; semantic fidelity is not assumed.' }
        # DacFx may script CREATE OR ALTER as CREATE and quote identifiers.
        if ($tokens.Count -ge 3 -and $tokens[0].TokenType.ToString() -eq 'Create' -and
            $tokens[1].TokenType.ToString() -eq 'Or' -and $tokens[2].TokenType.ToString() -eq 'Alter') {
            $tokens = @($tokens[0]) + @($tokens | Select-Object -Skip 3)
        }
        $position = 0
        $normalized = @(
            foreach ($token in $tokens) {
                $kind = $token.TokenType.ToString()
                $text = $token.Text
                if ($position -eq 0 -and $kind -eq 'Alter') { $kind = 'Create' }
                if ($kind -eq 'QuotedIdentifier') {
                    if ($text.StartsWith('[')) { $text = $text.Substring(1,$text.Length-2).Replace(']]',']') }
                    else { $text = $text.Substring(1,$text.Length-2).Replace('""','"') }
                    $kind = 'Identifier'
                }
                if ($kind -notmatch 'Identifier|Literal|Variable|Integer|Numeric|Real|Money|Binary') { $text = $kind }
                @($kind,$text)
                $position++
            }
        )
        return Get-StudioHash (ConvertTo-Json -InputObject $normalized -Compress -Depth 4)
    } finally { $reader.Dispose() }
}

function Get-StudioTableHashQuery {
    param([string] $Schema, [string] $Table, [object[]] $Columns)
    $quote = { param($value) '[' + $value.Replace(']', ']]') + ']' }
    $expressions = @(
        foreach ($column in $Columns) {
            # rowversion is intentionally regenerated by an import and is not an edit token to preserve.
            if ($column.TypeName -in @('timestamp','rowversion')) { continue }
            $identifier = & $quote ([string]$column.ColumnName)
            $style = switch ([string]$column.TypeName) {
                { $_ -in @('binary','varbinary','image','money','smallmoney') } { 2 }
                { $_ -in @('float','real') } { 3 }
                { $_ -in @('date','datetime','smalldatetime','datetime2','time','datetimeoffset') } { 126 }
                { $_ -in @('bigint','bit','decimal','int','numeric','smallint',
                    'tinyint','char','varchar','nchar','nvarchar','text','ntext','uniqueidentifier','json','vector') } { 0 }
                default { Stop-StudioOperation 'UnsupportedVerificationType' 'A source data type has no approved lossless comparison. Verification/export is blocked rather than claiming fidelity.' }
            }
            "CONVERT(nvarchar(max),$identifier,$style) AS $identifier"
        }
    )
    if ($expressions.Count -eq 0) { Stop-StudioOperation 'UnsupportedVerificationType' 'A table has no comparable non-rowversion columns.' }
    $qualified = "$(& $quote $Schema).$(& $quote $Table)"
    return "SELECT HASHBYTES('SHA2_256',CONVERT(varbinary(max),(SELECT $($expressions -join ',') FOR JSON PATH,WITHOUT_ARRAY_WRAPPER,INCLUDE_NULL_VALUES))) AS RowHash FROM $qualified ORDER BY RowHash;"
}

function Get-StudioDataEvidence {
    param($Connection)
    $columns = Invoke-StudioQuery $Connection @'
SELECT s.name AS SchemaName,t.name AS TableName,c.name AS ColumnName,c.column_id AS Ordinal,
       TYPE_NAME(c.system_type_id) AS TypeName,c.max_length AS MaxLength,c.precision AS PrecisionValue,
       c.scale AS ScaleValue,c.is_nullable AS NullableValue,c.is_identity AS IdentityValue,
       c.is_computed AS ComputedValue,COALESCE(cc.definition,N'') AS ComputedDefinition,
       COALESCE(mc.masking_function,N'') AS MaskingFunction,
       CONVERT(nvarchar(128),idc.seed_value) AS IdentitySeed,
       CONVERT(nvarchar(128),idc.increment_value) AS IdentityIncrement,
       CONVERT(nvarchar(128),idc.last_value) AS IdentityLastValue
FROM sys.tables AS t
JOIN sys.schemas AS s ON s.schema_id=t.schema_id
JOIN sys.columns AS c ON c.object_id=t.object_id
LEFT JOIN sys.computed_columns AS cc ON cc.object_id=c.object_id AND cc.column_id=c.column_id
LEFT JOIN sys.masked_columns AS mc ON mc.object_id=c.object_id AND mc.column_id=c.column_id
LEFT JOIN sys.identity_columns AS idc ON idc.object_id=c.object_id AND idc.column_id=c.column_id
WHERE t.is_ms_shipped=0 ORDER BY s.name,t.name,c.column_id;
'@
    $schemaRecords = @($columns.Rows | ForEach-Object {
        @($_.SchemaName,$_.TableName,$_.ColumnName,$_.Ordinal,$_.TypeName,$_.MaxLength,$_.PrecisionValue,
            $_.ScaleValue,$_.NullableValue,$_.IdentityValue,$_.ComputedValue,$_.ComputedDefinition,$_.MaskingFunction,
            $_.IdentitySeed,$_.IdentityIncrement,$_.IdentityLastValue)
    } | ConvertTo-Json -Depth 5 -Compress)
    $tables = [Collections.Generic.List[object]]::new()
    foreach ($group in ($columns.Rows | Group-Object -Property SchemaName,TableName)) {
        Assert-StudioNotCancelled
        $first = $group.Group[0]
        $query = Get-StudioTableHashQuery $first.SchemaName $first.TableName @($group.Group)
        $command = $Connection.CreateCommand()
        $hash = [Security.Cryptography.IncrementalHash]::CreateHash([Security.Cryptography.HashAlgorithmName]::SHA256)
        try {
            $command.CommandText = $query
            $command.CommandTimeout = 600
            $reader = $command.ExecuteReader()
            $count = [long]0
            try {
                while ($reader.Read()) {
                    if ($count % 1024 -eq 0) { Assert-StudioNotCancelled }
                    $hash.AppendData([byte[]]$reader.GetValue(0))
                    $count++
                }
            } finally { $reader.Dispose() }
            $tables.Add(@{name="$($first.SchemaName).$($first.TableName)";rowCount=$count;
                contentHash=[Convert]::ToHexString($hash.GetHashAndReset())})
        } finally { $hash.Dispose(); $command.Dispose() }
    }
    $metadata = Invoke-StudioQuery $Connection @'
SELECT N'INDEX' AS Kind,s.name AS SchemaName,t.name AS ObjectName,i.name AS ItemName,
       CONCAT(i.type_desc,N'|',i.is_unique,N'|',i.is_primary_key,N'|',i.is_disabled,N'|',
           COALESCE(i.filter_definition,N''),N'|',COALESCE(c.name,N''),N'|',
           COALESCE(CONVERT(nvarchar(10),ic.key_ordinal),N''),N'|',
           COALESCE(CONVERT(nvarchar(10),ic.is_descending_key),N''),N'|',
           COALESCE(CONVERT(nvarchar(10),ic.is_included_column),N'')) AS Detail
FROM sys.tables t JOIN sys.schemas s ON s.schema_id=t.schema_id
JOIN sys.indexes i ON i.object_id=t.object_id
LEFT JOIN sys.index_columns ic ON ic.object_id=i.object_id AND ic.index_id=i.index_id
LEFT JOIN sys.columns c ON c.object_id=ic.object_id AND c.column_id=ic.column_id
WHERE t.is_ms_shipped=0 AND i.index_id>0
UNION ALL
SELECT N'MODULE',s.name,o.name,N'',m.definition
FROM sys.sql_modules m JOIN sys.objects o ON o.object_id=m.object_id
JOIN sys.schemas s ON s.schema_id=o.schema_id WHERE o.is_ms_shipped=0
UNION ALL
SELECT N'PERMISSION',COALESCE(OBJECT_SCHEMA_NAME(p.major_id),N''),COALESCE(OBJECT_NAME(p.major_id),N''),
       USER_NAME(p.grantee_principal_id),CONCAT(p.class_desc,N'|',p.permission_name,N'|',p.state_desc,N'|',p.minor_id)
FROM sys.database_permissions p WHERE p.grantee_principal_id>4
ORDER BY Kind,SchemaName,ObjectName,ItemName,Detail;
'@
    $metadataRecords = @($metadata.Rows | ForEach-Object {
        $detail = if ($_.Kind -eq 'MODULE') { Get-StudioModuleFingerprint ([string]$_.Detail) } else { $_.Detail }
        @($_.Kind,$_.SchemaName,$_.ObjectName,$_.ItemName,$detail)
    } |
        ConvertTo-Json -Depth 5 -Compress)
    return @{tables=$tables.ToArray();schemaHash=Get-StudioHash ($schemaRecords -join '');
        metadataHash=Get-StudioHash ($metadataRecords -join '')}
}

function Compare-StudioEvidence {
    param($Source, $Target)
    if ($Source.schemaHash -cne $Target.schemaHash -or $Source.metadataHash -cne $Target.metadataHash) {
        Stop-StudioOperation 'SchemaVerificationFailed' 'Schema, masks, index metadata, modules, or permissions differ after import. Target is retained; feature fidelity is not verified.'
    }
    $sourceTables = @($Source.tables | Sort-Object name)
    $targetTables = @($Target.tables | Sort-Object name)
    if ($sourceTables.Count -ne $targetTables.Count) {
        Stop-StudioOperation 'ContentVerificationFailed' 'Source and target table inventories differ.'
    }
    for ($index = 0; $index -lt $sourceTables.Count; $index++) {
        $a = $sourceTables[$index]; $b = $targetTables[$index]
        if ($a.name -cne $b.name -or $a.rowCount -ne $b.rowCount -or $a.contentHash -cne $b.contentHash) {
            Stop-StudioOperation 'ContentVerificationFailed' 'Actual source/target row counts or content hashes differ. JSON, contacts, and vector values are not declared preserved.'
        }
    }
}

function Test-StudioCaseCapabilities {
    param($Source, $Target)
    $jsonSource = Invoke-StudioQuery $Source "SELECT COUNT_BIG(*) AS N FROM dbo.Cases WHERE JSON_VALUE(Details,'$.channel') = N'web';"
    $jsonTarget = Invoke-StudioQuery $Target "SELECT COUNT_BIG(*) AS N FROM dbo.Cases WHERE JSON_VALUE(Details,'$.channel') = N'web';"
    if ($jsonSource.Rows[0].N -ne $jsonTarget.Rows[0].N) {
        Stop-StudioOperation 'JsonVerificationFailed' 'The maintained native JSON filtering check differs on target.'
    }
    $ids = Invoke-StudioQuery $Source 'SELECT TOP (1) CaseId FROM dbo.Cases ORDER BY CaseId;'
    if ($ids.Rows.Count -eq 0) { Stop-StudioOperation 'MaskVerificationUnavailable' 'No case exists for a meaningful restricted mask verification.' }
    $caseId = [int]$ids.Rows[0].CaseId
    $masked = @(
        foreach ($connection in @($Source,$Target)) {
            $plain = Invoke-StudioQuery $connection 'SELECT u.Email,u.Phone FROM dbo.Cases c JOIN dbo.Customers u ON u.CustomerId=c.CustomerId WHERE c.CaseId=@id;' @{id=$caseId}
            $restriction = Invoke-StudioQuery $connection @'
EXECUTE AS USER = 'CustomerServiceDeskVerifier';
SELECT HAS_PERMS_BY_NAME(DB_NAME(),'DATABASE','UNMASK') AS CanUnmask,
       HAS_PERMS_BY_NAME(N'dbo.Customers','OBJECT','SELECT') AS CanSelect;
REVERT;
'@
            if ($restriction.Rows[0].CanUnmask -eq 1 -or $restriction.Rows[0].CanSelect -eq 1) {
                Stop-StudioOperation 'RuntimeOverprivileged' 'The migrated verifier is not a restricted runtime principal.'
            }
            try {
                [void](Invoke-StudioQuery $connection "EXECUTE AS USER = 'CustomerServiceDeskVerifier';")
                $row = Invoke-StudioQuery $connection 'EXEC dbo.GetCase @CaseId=@id;' @{id=$caseId}
            } finally { [void](Invoke-StudioQuery $connection 'REVERT;') }
            if ($row.Rows.Count -ne 1 -or $row.Rows[0].Email -ceq $plain.Rows[0].Email -or
                $row.Rows[0].Phone -ceq $plain.Rows[0].Phone) {
                Stop-StudioOperation 'MaskVerificationFailed' 'The restricted stored-procedure contact check did not mask both fields.'
            }
            Get-StudioHash ("$($row.Rows[0].Email)|$($row.Rows[0].Phone)")
        }
    )
    if ($masked[0] -cne $masked[1]) { Stop-StudioOperation 'MaskVerificationFailed' 'Restricted contact masking differs on target.' }
    $prepared = Invoke-StudioQuery $Source @'
SELECT TOP (1) e.PreparedSearchId,s.ExpectedTopic FROM dbo.QueryEmbeddings e
JOIN dbo.PreparedSearches s ON s.PreparedSearchId=e.PreparedSearchId
JOIN dbo.DemoConfiguration d ON d.ActiveProfileId=e.ProfileId
WHERE d.ConfigurationId=1 ORDER BY e.PreparedSearchId;
'@
    if ($prepared.Rows.Count -eq 0) {
        Stop-StudioOperation 'PreparedSearchUnavailable' 'A real prepared query embedding is required to verify retrieval.'
    }
    foreach ($connection in @($Source,$Target)) {
        $hits = Invoke-StudioQuery $connection 'EXEC dbo.SearchPreparedCases @PreparedSearchId=@id;' @{id=[int]$prepared.Rows[0].PreparedSearchId}
        if ($hits.Rows.Count -eq 0 -or
            @($hits.Rows | Where-Object {
                $_.CosineDistance -is [DBNull] -or -not [double]::IsFinite([double]$_.CosineDistance) -or
                [double]$_.CosineDistance -lt 0 -or [double]$_.CosineDistance -gt 2.001
            }).Count -gt 0 -or
            @($hits.Rows | Where-Object Topic -eq $prepared.Rows[0].ExpectedTopic).Count -eq 0) {
            Stop-StudioOperation 'PreparedSearchFailed' 'Prepared vector retrieval did not return meaningful cosine-search results.'
        }
    }
    return @(
        @{name='Stored contacts, native JSON, vectors, embedding profiles';state='verified';message='Privileged full-table content hashes and row counts match; rowversion bytes excluded.'},
        @{name='Columns, masks, basic index catalog, modules, permissions';state='verified';message='Compared normalized catalog evidence; not every engine-specific index option.'},
        @{name='Native JSON filtering';state='verified';message='Maintained channel predicate returns matching counts.'},
        @{name='Restricted contact masks';state='verified';message='Existing verifier cannot directly select contacts or UNMASK; both fields are masked through GetCase.'},
        @{name='Prepared vector retrieval';state='verified';message='A stored query embedding returns finite cosine distances and the expected topic on both endpoints.'},
        @{name='ANN execution plan';state='not tested';message='Index presence and successful search do not prove an ANN plan.'},
        @{name='Engine-specific index options';state='not tested';message='Basic catalog comparison does not prove every JSON/vector index setting.'},
        @{name='Live embedding inference and external runtime login';state='not tested';message='No inference or application cutover is performed. The contained verifier is tested, not a new app login.'}
    )
}

function Invoke-StudioTransfer {
    param([System.Collections.IDictionary] $Config, [string] $FrozenRequest, [ValidateSet('Export','Import')] [string] $Action)
    $pwsh = Join-Path $PSHOME 'pwsh.exe'
    $result = Invoke-StudioNative $pwsh @('-NoLogo','-NoProfile','-NonInteractive','-File',
        (Join-Path $PSScriptRoot 'Invoke-StudioDacTransfer.ps1'),'-Action',$Action,'-InputFile',$FrozenRequest) -AllowFailure
    if ($result.exitCode -ne 0) {
        Stop-StudioOperation 'TransferFailed' 'DacFx transfer failed or was cancelled. No raw diagnostics are exposed; partial target state and protected evidence are retained. Re-inspect before retrying.'
    }
    try { $state = ConvertFrom-Json -InputObject $result.output }
    catch { Stop-StudioOperation 'TransferFailed' 'DacFx transfer did not return a confirmed completion.' }
    if (-not $state.success) { Stop-StudioOperation 'TransferFailed' 'DacFx transfer did not confirm success.' }
}

function Invoke-StudioMigration {
    param([System.Collections.IDictionary] $Config, [string] $InputFile)
    Assert-StudioConfiguration $Config 'Migrate'
    Protect-StudioDirectory $Config.runDirectory
    Set-StudioRunContext $Config.runDirectory
    $marker = Join-Path $Config.runDirectory 'engine-execution.json'
    try { $lock = [IO.File]::Open($marker,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None) }
    catch { Stop-StudioOperation 'RunAlreadyStarted' 'This run already started. Re-inspect its retained state; never blindly repeat a lost provisioning/import response.' }
    $frozen = Join-Path $Config.runDirectory 'engine-request.json'
    $sourceConnection=$null; $targetConnection=$null; $source=$null
    $stage = 'preflight'
    try {
        $request = ConvertTo-Json -InputObject $Config -Depth 10 -Compress
        $bytes = [Text.Encoding]::UTF8.GetBytes((ConvertTo-Json -InputObject @{
            configurationHash=Get-StudioHash $request;startedAt=[DateTimeOffset]::UtcNow.ToString('O');state='started'
        } -Compress))
        $lock.Write($bytes,0,$bytes.Length)
        $lock.Flush($true)
        $requestStream = [IO.File]::Open($frozen,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::Read)
        try { $requestBytes=[Text.Encoding]::UTF8.GetBytes($request);$requestStream.Write($requestBytes,0,$requestBytes.Length) }
        finally { $requestStream.Dispose() }
        Write-StudioEvent $stage 'running' 'Checking approved configuration, source consistency, tooling, and selected identity.'
        Assert-StudioNotCancelled
        [void](Get-StudioSqlPackage)
        $identity = Get-StudioIdentity $Config
        $source = Get-StudioSource -Credential
        $sourceConnection = Open-StudioSourceConnection $source $Config.sourceDatabase
        Assert-StudioSourceReadOnly $sourceConnection
        $before = Get-StudioDataEvidence $sourceConnection
        if (@($before.tables | Where-Object name -eq 'dbo.Cases').Count -ne 1) {
            Stop-StudioOperation 'UnsupportedSource' 'This feature-verification release requires the Customer Service Desk schema.'
        }
        Write-StudioEvent $stage 'succeeded' 'Source READ_ONLY and privileged content evidence established. Source state was not changed.'
        $stage = 'provision'
        Write-StudioEvent $stage 'running' 'Creating only approved resources and an empty free-protected target; no firewall rules are changed.'
        Assert-StudioNotCancelled
        New-StudioTarget $Config $identity
        $targetConnection = Open-StudioTargetConnection $Config
        Assert-StudioEmptyTarget $targetConnection
        Write-StudioEvent $stage 'succeeded' 'Free protections and empty target verified.'
        $stage = 'export'
        Write-StudioEvent $stage 'running' 'Exporting the read-only source with DacFx. Progress is indeterminate.'
        Assert-StudioSourceReadOnly $sourceConnection
        Invoke-StudioTransfer $Config $frozen 'Export'
        Assert-StudioSourceReadOnly $sourceConnection
        $after = Get-StudioDataEvidence $sourceConnection
        Compare-StudioEvidence $before $after
        Write-StudioEvent $stage 'succeeded' 'BACPAC exported; source remained read-only with matching pre/post content evidence.'
        $stage = 'import'
        Write-StudioEvent $stage 'running' 'Rechecking free protections and target emptiness before import. Progress is indeterminate.'
        Assert-StudioFreeDatabase (Get-StudioTargetDatabase $Config)
        Assert-StudioEmptyTarget $targetConnection
        Invoke-StudioTransfer $Config $frozen 'Import'
        Write-StudioEvent $stage 'succeeded' 'DacFx import completed; target retained for measured verification.'
        $stage = 'verify'
        Write-StudioEvent $stage 'running' 'Comparing actual counts, content, metadata, restricted masks, JSON, and prepared retrieval.'
        Assert-StudioFreeDatabase (Get-StudioTargetDatabase $Config)
        Assert-StudioSourceReadOnly $sourceConnection
        $targetEvidence = Get-StudioDataEvidence $targetConnection
        Compare-StudioEvidence $before $targetEvidence
        $capabilities = @(Test-StudioCaseCapabilities $sourceConnection $targetConnection)
        $result = @{success=$true;verified=$true;state='verified';sourceOperationalStateChanged=$false;targetRetained=$true;
            tables=@($targetEvidence.tables | ForEach-Object { @{name=$_.name;rowCount=$_.rowCount} });
            capabilities=$capabilities;rowversion='Regenerated; stale application edit tokens must not be reused.';
            cutover='Not performed. Service Desk configuration and source READ_ONLY state are unchanged.'}
        [IO.File]::WriteAllText((Join-Path $Config.runDirectory 'engine-verification.json'),(ConvertTo-Json -InputObject @{
            source=$before;target=$targetEvidence;result=$result
        } -Depth 20))
        Write-StudioEvent $stage 'succeeded' 'Measured verification passed for the listed capabilities; untested capabilities remain explicit.'
        return $result
    } catch {
        $safe = Get-StudioSafeError $_
        Write-StudioEvent $stage 'failed' $safe.message
        [IO.File]::WriteAllText((Join-Path $Config.runDirectory 'engine-failure.json'),(ConvertTo-Json -InputObject @{
            stage=$stage;code=$safe.code;message=$safe.message;targetMayBePartial=$true;sourceOperationalStateChanged=$false
        } -Compress))
        throw
    } finally {
        if ($targetConnection) { $targetConnection.Dispose() }
        if ($sourceConnection) { $sourceConnection.Dispose() }
        if ($source -and $source.password) { $source.password.Dispose() }
        $lock.Dispose()
    }
}

Export-ModuleMember -Function *-Studio*
