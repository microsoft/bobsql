# ---------------------------------------------------------------------------
# AI-Ready SQL - your environment
#
# Copy this file to ai.env, fill in the values, and every script in this
# folder picks them up. Nothing in this area has a built-in default: a
# default resource name is always somebody else's environment, and a reader who
# forgets an argument would silently aim at it.
#
#     cp ai.env.template ai.env      # or: Copy-Item
#
# ai.env is git-ignored, so your names never land in a commit and your edits
# never collide with a pull.
#
# This file stands on its own. If you did Getting Started, the first three values are
# the ones you already used and you can copy them straight across - but nothing
# here reaches into another area to find them.
#
# Fill every value that is not marked optional. A value still in <angle
# brackets> counts as unfilled and the scripts will stop and tell you which
# line to fix.
#
# These are resource NAMES, not secrets. There is no password and no key in
# this area - the database reaches Azure OpenAI with a managed identity.
# Even so, keep ai.env out of source control; it describes your subscription.
#
# To check your entries before anything is created:  ./check-ai-env.ps1
# ---------------------------------------------------------------------------


# -- Where things live --------------------------------------------------------

# Resource group holding the logical server. The AI resources are created here
# too. Getting Started called this RG.
RG=<your-resource-group>

# SHORT name of the logical server - not the FQDN. This is the server whose
# managed identity gets the Cognitive Services OpenAI User role.
#   right: contoso-sql-01        wrong: contoso-sql-01.database.windows.net
SRV=<your-sql-server-short-name>

# Optional. Leave as-is to use whatever `az account show` reports.
SUBSCRIPTION_ID=<optional-subscription-id>


# -- The AI resources ---------------------------------------------------------

# Name for the Microsoft Foundry (Azure OpenAI) account. It becomes
# <name>.openai.azure.com, so it must be globally unique across Azure - expect
# anything obvious to collide. This is the value you also paste into the
# <your-foundry> placeholder in 06, 08 and 10.
AI_RESOURCE=<your-foundry-name>

# APIM's required publisher contact. Not used if you skip the gateway.
PUBLISHER_EMAIL=<your-email>

# Optional, and only if you ALREADY have a Content Safety resource whose name
# is not <AI_RESOURCE>-contentsafety. That derived name is how deploy-ai.ps1
# decides one exists, so a differently-named resource means a run creates a
# SECOND one beside it and re-points the gateway policy at the new one. This is
# the single value in this file that changes what gets created rather than just
# what gets named. Leave it as-is and the derived name is used.
CS_RESOURCE=<optional-existing-content-safety-name>

# Optional. The APIM instance name. deploy-ai.ps1 always derives this as
# <AI_RESOURCE>-gateway and has no switch to override it; this entry is here so
# check-ai-env.ps1 and reset-ai-azure.ps1 can find an instance you named
# differently. Leave it as-is unless you know you did.
APIM_NAME=<optional-apim-name>


# -- The application ----------------------------------------------------------
# These two are read by the app itself, at the highest precedence it honours,
# so run-ai-app.ps1 needs no -Server or -Database once they are set here.

# FULL name of the server this time - the app opens a connection to it.
WardGeneral__Server=<your-sql-server>.database.windows.net

# The Getting Started database. Almost certainly wardgeneral.
WardGeneral__Database=wardgeneral
