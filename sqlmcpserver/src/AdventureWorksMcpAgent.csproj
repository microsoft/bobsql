<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AdventureWorksMcpAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework + Microsoft Foundry + the MCP C# SDK.
         All prerelease today; pin latest with: dotnet add package <name> --prerelease
         The .AsAIAgent(...) Foundry extension ships in the Azure AI integration for
         Agent Framework — if it's not resolved by Microsoft.Agents.AI, add the
         Azure AI hosting package (Microsoft.Agents.AI.AzureAI) as well. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="*-*" />
    <PackageReference Include="Azure.AI.Projects" Version="*-*" />
    <PackageReference Include="Azure.Identity" Version="*" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="*" />
    <PackageReference Include="ModelContextProtocol" Version="*-*" />
  </ItemGroup>

</Project>
